  "cards": [
    {
      "dot": "cyan",
      "title": "两条数据路径",
      "items": [
        "上排：GW 固定签名，TCS 原子保存任务、四维账户、ACCEPTED、事件与 outbox。",
        "下排：同一 PostgreSQL 的历史事件与审计分区，经 archived 编码后写入对象存储。"
      ]
    },
    {
      "dot": "amber",
      "title": "当前范围",
      "items": [
        "账本和事件分区是同库不同逻辑集合，不是两个独立权威库。",
        "参数内容存放与 effect 执行见时序图；原始参数不写入 outbox。",
        "ART 产物引用、证据清单与 VERIFIED 不属于当前归档数据流。"
      ]
